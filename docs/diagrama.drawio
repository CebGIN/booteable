        <mxCell id="1" parent="0"/>
        <mxCell id="cmp_title" parent="1" style="text;html=1;whiteSpace=wrap;overflow=visible;rounded=0;align=left;verticalAlign=top;fontSize=11;" value="&lt;b&gt;&lt;font style='font-size:18px'&gt;Arquitectura de componentes · booteable&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;El preparador construye y verifica el medio; el firmware ejecuta el programa EFI. Dos mundos, un contrato de formato.&lt;/font&gt;" vertex="1"><mxGeometry height="50" width="1120" x="40" y="12" as="geometry"/></mxCell>
        <mxCell id="cmp_prep" parent="1" style="swimlane;html=1;startSize=46;collapsible=0;container=1;fontStyle=1;verticalAlign=top;align=center;fillColor=#f5f5f5;strokeColor=#000000;strokeWidth=1.2;whiteSpace=wrap;rounded=0;" value="&lt;b&gt;Preparador · proceso Linux&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px;color:#555555'&gt;TUI Guayaba · syscalls Linux · construir no requiere root; escribir sí&lt;/font&gt;" vertex="1"><mxGeometry height="700" width="780" x="40" y="70" as="geometry"/></mxCell>
        <mxCell id="cmp_fw" parent="1" style="swimlane;html=1;startSize=46;collapsible=0;container=1;fontStyle=1;verticalAlign=top;align=center;fillColor=#f5f5f5;strokeColor=#000000;strokeWidth=1.2;whiteSpace=wrap;rounded=0;" value="&lt;b&gt;Equipo de prueba · firmware UEFI&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px;color:#555555'&gt;x86_64 · sin SO · solo servicios de arranque&lt;/font&gt;" vertex="1"><mxGeometry height="700" width="550" x="1050" y="70" as="geometry"/></mxCell>
        <mxCell id="cmp_ui" parent="1" style="shape=component;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.2;fontSize=11;spacing=4;" value="&lt;b&gt;ui/&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:9px;color:#666666'&gt;sin lógica de negocio&lt;/font&gt;&lt;br&gt;MainScene · ConfirmDialog · ProgressScene&lt;br&gt;ResultScene · UiFormat&lt;br&gt;Solo incluye app/ y domain/" vertex="1"><mxGeometry height="95" width="720" x="70" y="140" as="geometry"/></mxCell>
        <mxCell id="cmp_app" parent="1" style="shape=component;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.2;fontSize=11;spacing=4;" value="&lt;b&gt;app/&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:9px;color:#666666'&gt;dueño del ciclo de vida&lt;/font&gt;&lt;br&gt;PrepController · PrepRunner · CancellationToken&lt;br&gt;FakePrepController&lt;br&gt;Orquesta etapas, progreso y cancelación" vertex="1"><mxGeometry height="95" width="720" x="70" y="270" as="geometry"/></mxCell>
        <mxCell id="cmp_image" parent="1" style="shape=component;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.2;fontSize=11;spacing=4;" value="&lt;b&gt;image/&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:9px;color:#666666'&gt;la imagen se construye, no se copia&lt;/font&gt;&lt;br&gt;BootImageBuilder · GptWriter · Fat32Writer&lt;br&gt;ImageVerifier · ImageLayout" vertex="1"><mxGeometry height="105" width="325" x="70" y="405" as="geometry"/></mxCell>
        <mxCell id="cmp_device" parent="1" style="shape=component;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.2;fontSize=11;spacing=4;" value="&lt;b&gt;device/&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:9px;color:#666666'&gt;el único que toca /sys y /dev&lt;/font&gt;&lt;br&gt;SysfsBlockDeviceSource · SafetyPolicy&lt;br&gt;MountManager · PosixDeviceWriter" vertex="1"><mxGeometry height="105" width="315" x="435" y="405" as="geometry"/></mxCell>
        <mxCell id="cmp_core" parent="1" style="shape=component;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.2;fontSize=11;spacing=4;" value="&lt;b&gt;core/&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:9px;color:#666666'&gt;sin Linux ni Guayaba&lt;/font&gt;&lt;br&gt;Sha256 · Crc32 · SizeFormat · Bytes · usado por image/ y device/" vertex="1"><mxGeometry height="75" width="680" x="70" y="545" as="geometry"/></mxCell>
        <mxCell id="cmp_cli" parent="1" style="shape=component;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.2;fontSize=11;spacing=4;" value="&lt;b&gt;cli/ · booteable-image&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:9px;color:#666666'&gt;entrada headless&lt;/font&gt;&lt;br&gt;build · verify · flash · compone booteable_core sin UI" vertex="1"><mxGeometry height="75" width="680" x="70" y="655" as="geometry"/></mxCell>
        <mxCell id="cmp_usb" parent="1" style="shape=package;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1;fontSize=11;" value="&lt;b&gt;Medio USB preparado&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:9px;color:#666666'&gt;imagen dispersa y determinista&lt;/font&gt;&lt;br&gt;GPT primaria + respaldo&lt;br&gt;ESP FAT32 sin LFN&lt;br&gt;&lt;font face='monospace' style='font-size:9px'&gt;\EFI\BOOT\&lt;br&gt;BOOTX64.EFI&lt;/font&gt;" vertex="1"><mxGeometry height="170" width="230" x="800" y="390" as="geometry"/></mxCell>
        <mxCell id="cmp_fwinfo" parent="1" style="shape=component;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.2;fontSize=11;spacing=4;" value="&lt;b&gt;Firmware UEFI&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:9px;color:#666666'&gt;OVMF en QEMU o equipo real&lt;/font&gt;&lt;br&gt;Busca &lt;font face='monospace'&gt;\EFI\BOOT\BOOTX64.EFI&lt;/font&gt; en la ESP" vertex="1"><mxGeometry height="80" width="490" x="1080" y="140" as="geometry"/></mxCell>
        <mxCell id="cmp_svc" parent="1" style="shape=component;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.2;fontSize=11;spacing=4;" value="&lt;b&gt;EFI_BOOT_SERVICES · EFI_SYSTEM_TABLE&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:9px;color:#666666'&gt;protocolos de arranque&lt;/font&gt;&lt;br&gt;ConOut · ConIn · Stall · SerialIo&lt;br&gt;RuntimeServices-&amp;gt;ResetSystem" vertex="1"><mxGeometry height="100" width="490" x="1080" y="255" as="geometry"/></mxCell>
        <mxCell id="cmp_boot" parent="1" style="shape=component;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.2;fontSize=11;spacing=4;" value="&lt;b&gt;boot/ · BOOTX64.EFI&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:9px;color:#666666'&gt;PE32+ · -nostdlib · sin EDK2&lt;/font&gt;&lt;br&gt;efi_main · efi.cpp" vertex="1"><mxGeometry height="100" width="490" x="1080" y="390" as="geometry"/></mxCell>
        <mxCell id="cmp_out" parent="1" style="shape=component;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.2;fontSize=11;spacing=4;" value="&lt;b&gt;Salida visible&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:9px;color:#666666'&gt;consola de texto y puerto serie&lt;/font&gt;&lt;br&gt;Mensaje del grupo + &lt;b&gt;BOOTEABLE-BOOT-OK&lt;/b&gt;" vertex="1"><mxGeometry height="90" width="490" x="1080" y="525" as="geometry"/></mxCell>
        <mxCell id="cmp_note_secure" parent="1" style="shape=note;whiteSpace=wrap;html=1;size=10;fillColor=#ffffff;strokeColor=#000000;fontSize=9;align=left;verticalAlign=top;spacing=4;" value="&lt;b&gt;Secure Boot&lt;/b&gt; · el PE no está firmado: con Secure Boot activo no arranca. Se documenta y se prueba en un equipo de laboratorio con autorización." vertex="1"><mxGeometry height="55" width="490" x="1080" y="645" as="geometry"/></mxCell>
        <mxCell id="cmp_note_embed" parent="1" style="shape=note;whiteSpace=wrap;html=1;size=10;fillColor=#ffffff;strokeColor=#000000;fontSize=9;align=left;verticalAlign=top;spacing=4;" value="&lt;b&gt;Incrustación&lt;/b&gt; · el EFI se compila con MinGW-w64 y se enlaza como arreglo en el preparador; no se copia un archivo externo." vertex="1"><mxGeometry height="50" width="490" x="1080" y="710" as="geometry"/></mxCell>
        <mxCell id="cmp_format" parent="1" style="shape=package;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1;fontSize=11;" value="&lt;b&gt;Formato compartido · contrato del medio (no se comparte código)&lt;/b&gt;&lt;br&gt;GPT primaria y de respaldo · ESP FAT32 sin LFN · ruta \EFI\BOOT\BOOTX64.EFI · sectores 512 / 4096 · etiqueta BOOTEABLE&lt;br&gt;El preparador usa syscalls de Linux; el arranque usa EFI_BOOT_SERVICES. Solo coinciden en el formato byte a byte." vertex="1"><mxGeometry height="95" width="1560" x="40" y="820" as="geometry"/></mxCell>
