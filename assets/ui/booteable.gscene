# Shell de la TUI de booteable.
#
# Un .gscene tiene exactamente un nodo raíz y el formato no admite include ni
# composición declarativa. El resto de las pantallas vive en archivos separados
# y AppScene las injerta bajo "rail_slot" y "stage_slot" con un tema compartido.

format = 1
name = "BooteableShell"
theme = "booteable.gtheme"

# El root es el único panel de fondo: pinta toda la pantalla de negro para que
# no se filtren las celdas sin cubrir del buffer (que arranca en blanco). Las
# pantallas se apilan encima y no necesitan repetir el fondo.
PanelContainer "content" {
    anchors = "full_rect"
    style = "background"
    clip_children = true

    HBox "app_frame" {
        anchors = "full_rect"
        separation = 0

        # Ancho 4 plegado y 18 desplegado. AppScene cambia el mínimo del slot;
        # el rail lo llena con anchors = "full_rect".
        Control "rail_slot" {
            anchors = "full_rect"
            custom_minimum_size = [5, 0]
            grow_x = "none"
            grow_y = "both"
            clip_children = true
        }

        VBox "shell" {
            anchors = "full_rect"
            separation = 0
            grow_x = "both"
            grow_y = "both"

            Label "app_title" {
                text = "booteable | Preparador UEFI"
                custom_minimum_size = [0, 1]
                anchor_right = 1.0
                grow_x = "both"
                clip_children = true
                text_color = "BRIGHT_CYAN"
            }

            Label "app_rule" {
                text = "----------------------------------------------------------------"
                custom_minimum_size = [0, 1]
                anchor_right = 1.0
                grow_x = "both"
                clip_children = true
                text_color = "BRIGHT_BLACK"
            }

            # Escenario del wizard: solo un panel visible por vez. AppScene anima
            # anchor_left/anchor_right para deslizarlos.
            Control "stage_slot" {
                anchors = "full_rect"
                custom_minimum_size = [40, 11]
                grow_x = "both"
                grow_y = "both"
                clip_children = true
            }

            Label "status" {
                text = ""
                custom_minimum_size = [0, 2]
                anchor_right = 1.0
                grow_x = "both"
                clip_children = true
                text_color = "BRIGHT_BLACK"
            }
        }
    }
}
