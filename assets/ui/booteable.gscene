# Escena principal de la TUI de booteable.
#
# El árbol estático vive acá: los cuatro paneles, sus textos iniciales y sus
# estilos. Las señales, el refresco con datos reales y el layout responsive
# (AdaptiveScreen) siguen en C++, porque el formato no declara scripts ni tipos
# propios.
#
# El nodo raíz se injerta como hijo de "screen" en AppScene::build(); por eso
# las rutas de los widgets empiezan con "content/".

format = 1
name = "Booteable"
theme = "booteable.gtheme"

Control "content" {
    anchors = "full_rect"
    clip_children = true

    PanelContainer "main" {
        anchors = "full_rect"
        style = "panel"
        clip_children = true

        VBox "main_layout" {
            anchors = "full_rect"
            separation = 0

            Label "app_title" {
                text = "booteable | Preparador UEFI"
                custom_minimum_size = [0, 1]
                anchor_right = 1.0
                grow_x = "both"
                clip_children = true
                text_color = "BRIGHT_CYAN"
            }

            Label "app_rule" {
                text = "----------------------------------------------------------------"
                custom_minimum_size = [0, 1]
                anchor_right = 1.0
                grow_x = "both"
                clip_children = true
                text_color = "BRIGHT_BLACK"
            }

            SplitContainer "main_split" {
                anchors = "full_rect"
                divider_width = 1
                focus_mode = "none"

                PanelContainer "devices_panel" {
                    anchors = "full_rect"
                    style = "panel"
                    clip_children = true

                    VBox "devices_layout" {
                        anchors = "full_rect"
                        separation = 0

                        Label "devices_count" {
                            text = "USB detectadas: 0"
                            custom_minimum_size = [0, 1]
                            anchor_right = 1.0
                            grow_x = "both"
                            clip_children = true
                            text_color = "BRIGHT_WHITE"
                        }

                        ListView "device_list" {
                            anchors = "full_rect"
                            custom_minimum_size = [12, 5]
                        }
                    }
                }

                PanelContainer "details_panel" {
                    anchors = "full_rect"
                    style = "panel"
                    clip_children = true

                    VBox "details_layout" {
                        anchors = "full_rect"
                        separation = 0

                        Label "detail_title" {
                            text = "Sin dispositivo seleccionado"
                            custom_minimum_size = [0, 1]
                            anchor_right = 1.0
                            grow_x = "both"
                            clip_children = true
                            text_color = "BRIGHT_WHITE"
                        }

                        Label "detail_model" {
                            text = "Modelo: -"
                            custom_minimum_size = [0, 1]
                            anchor_right = 1.0
                            grow_x = "both"
                            clip_children = true
                        }

                        Label "detail_capacity" {
                            text = "Capacidad: -"
                            custom_minimum_size = [0, 1]
                            anchor_right = 1.0
                            grow_x = "both"
                            clip_children = true
                        }

                        Label "detail_serial" {
                            text = "Serie: -"
                            custom_minimum_size = [0, 1]
                            anchor_right = 1.0
                            grow_x = "both"
                            clip_children = true
                        }

                        Label "detail_by_id" {
                            text = "by-id: -"
                            custom_minimum_size = [0, 1]
                            anchor_right = 1.0
                            grow_x = "both"
                            clip_children = true
                            text_color = "BRIGHT_BLACK"
                        }

                        Label "detail_mounts" {
                            text = "Montajes: -"
                            custom_minimum_size = [0, 1]
                            anchor_right = 1.0
                            grow_x = "both"
                            clip_children = true
                        }

                        Label "detail_safety" {
                            text = "Seguridad: -"
                            custom_minimum_size = [0, 1]
                            anchor_right = 1.0
                            grow_x = "both"
                            clip_children = true
                        }

                        Label "detail_image" {
                            text = "Imagen: GPT | ESP FAT32 | etiqueta BOOTEABLE"
                            custom_minimum_size = [0, 1]
                            anchor_right = 1.0
                            grow_x = "both"
                            clip_children = true
                        }

                        HBox "detail_buttons" {
                            custom_minimum_size = [0, 3]
                            separation = 2

                            Button "prepare" {
                                text = "[ Preparar USB ]"
                                custom_minimum_size = [18, 3]
                            }

                            Button "export" {
                                text = "[ Exportar imagen ]"
                                custom_minimum_size = [20, 3]
                            }
                        }
                    }
                }
            }

            Label "status" {
                text = ""
                custom_minimum_size = [0, 2]
                anchor_right = 1.0
                grow_x = "both"
                clip_children = true
                text_color = "BRIGHT_BLACK"
            }
        }
    }

    PanelContainer "confirm" {
        visible = false
        anchor_left = 0.08
        anchor_right = 0.92
        anchor_top = 0.10
        anchor_bottom = 0.90
        grow_x = "both"
        grow_y = "both"
        style = "confirm_panel"
        clip_children = true

        VBox "confirm_layout" {
            anchors = "full_rect"
            separation = 0

            Label "confirm_title" {
                text = "Confirmar sobrescritura"
                custom_minimum_size = [0, 1]
                anchor_right = 1.0
                grow_x = "both"
                clip_children = true
                text_color = "BRIGHT_RED"
            }

            Label "confirm_summary" {
                text = "Destino: -"
                custom_minimum_size = [0, 2]
                anchor_right = 1.0
                grow_x = "both"
                clip_children = true
                text_color = "BRIGHT_WHITE"
            }

            Label "confirm_warning" {
                text = "Se perderá todo el contenido del dispositivo."
                custom_minimum_size = [0, 2]
                anchor_right = 1.0
                grow_x = "both"
                clip_children = true
                text_color = "BRIGHT_RED"
            }

            CheckBox "confirm_checkbox" {
                text = "Entiendo que se perderá todo el contenido"
                custom_minimum_size = [0, 1]
                anchor_right = 1.0
                grow_x = "both"
                text_color = "BRIGHT_YELLOW"
            }

            HBox "confirm_buttons" {
                custom_minimum_size = [0, 3]
                separation = 2

                Button "confirm_cancel" {
                    text = "[ Cancelar ]"
                    custom_minimum_size = [14, 3]
                }

                Button "confirm_overwrite" {
                    text = "[ Sobrescribir ]"
                    custom_minimum_size = [18, 3]
                    style.normal = "button.danger.normal"
                    style.hover = "button.danger.hover"
                    style.pressed = "button.danger.pressed"
                    style.disabled = "button.danger.disabled"
                }
            }

            Label "confirm_status" {
                text = ""
                custom_minimum_size = [0, 1]
                anchor_right = 1.0
                grow_x = "both"
                clip_children = true
                text_color = "BRIGHT_YELLOW"
            }
        }
    }

    PanelContainer "progress" {
        visible = false
        anchor_left = 0.05
        anchor_right = 0.95
        anchor_top = 0.06
        anchor_bottom = 0.94
        grow_x = "both"
        grow_y = "both"
        style = "progress_panel"
        clip_children = true

        VBox "progress_layout" {
            anchors = "full_rect"
            separation = 0

            Label "progress_title" {
                text = "Preparando USB"
                custom_minimum_size = [0, 1]
                anchor_right = 1.0
                grow_x = "both"
                clip_children = true
                text_color = "BRIGHT_CYAN"
            }

            Label "progress_detail" {
                text = "Esperando..."
                custom_minimum_size = [0, 1]
                anchor_right = 1.0
                grow_x = "both"
                clip_children = true
                text_color = "BRIGHT_WHITE"
            }

            ProgressBar "progress_bar" {
                custom_minimum_size = [0, 3]
                anchor_right = 1.0
                grow_x = "both"
                show_percentage = true
            }

            Label "step_0" {
                text = ""
                custom_minimum_size = [0, 1]
                anchor_right = 1.0
                grow_x = "both"
                clip_children = true
            }

            Label "step_1" {
                text = ""
                custom_minimum_size = [0, 1]
                anchor_right = 1.0
                grow_x = "both"
                clip_children = true
            }

            Label "step_2" {
                text = ""
                custom_minimum_size = [0, 1]
                anchor_right = 1.0
                grow_x = "both"
                clip_children = true
            }

            Label "step_3" {
                text = ""
                custom_minimum_size = [0, 1]
                anchor_right = 1.0
                grow_x = "both"
                clip_children = true
            }

            Label "step_4" {
                text = ""
                custom_minimum_size = [0, 1]
                anchor_right = 1.0
                grow_x = "both"
                clip_children = true
            }

            Label "step_5" {
                text = ""
                custom_minimum_size = [0, 1]
                anchor_right = 1.0
                grow_x = "both"
                clip_children = true
            }

            Button "progress_cancel" {
                text = "[ Cancelar ]"
                custom_minimum_size = [14, 3]
                style.normal = "button.warning.normal"
                style.hover = "button.warning.hover"
                style.pressed = "button.warning.pressed"
                style.disabled = "button.warning.disabled"
            }

            Label "progress_status" {
                text = ""
                custom_minimum_size = [0, 2]
                anchor_right = 1.0
                grow_x = "both"
                clip_children = true
                text_color = "BRIGHT_BLACK"
            }
        }
    }

    PanelContainer "result" {
        visible = false
        anchor_left = 0.06
        anchor_right = 0.94
        anchor_top = 0.05
        anchor_bottom = 0.95
        grow_x = "both"
        grow_y = "both"
        style = "result_panel"
        clip_children = true

        VBox "result_layout" {
            anchors = "full_rect"
            separation = 0

            Label "result_outcome" {
                text = "SIN RESULTADO"
                custom_minimum_size = [0, 1]
                anchor_right = 1.0
                grow_x = "both"
                clip_children = true
                text_color = "BRIGHT_WHITE"
            }

            Label "result_stage" {
                text = "Etapa: -"
                custom_minimum_size = [0, 1]
                anchor_right = 1.0
                grow_x = "both"
                clip_children = true
                text_color = "BRIGHT_WHITE"
            }

            Label "result_message" {
                text = ""
                custom_minimum_size = [0, 2]
                anchor_right = 1.0
                grow_x = "both"
                clip_children = true
                text_color = "BRIGHT_WHITE"
            }

            Label "result_details" {
                text = ""
                custom_minimum_size = [0, 1]
                anchor_right = 1.0
                grow_x = "both"
                clip_children = true
                text_color = "BRIGHT_BLACK"
            }

            Label "result_hashes" {
                text = ""
                custom_minimum_size = [0, 2]
                anchor_right = 1.0
                grow_x = "both"
                clip_children = true
                text_color = "BRIGHT_BLACK"
            }

            Label "result_commands" {
                text = "Prueba virtual:  ./tools/run-qemu.sh --headless --image build/booteable.img\nPrueba física:   reiniciar, abrir el menú de arranque y elegir la USB\nSecure Boot:     debe estar desactivado en el equipo de prueba"
                custom_minimum_size = [0, 3]
                anchor_right = 1.0
                grow_x = "both"
                clip_children = true
                text_color = "BRIGHT_CYAN"
            }

            HBox "result_buttons" {
                custom_minimum_size = [0, 3]
                separation = 2

                Button "result_back" {
                    text = "[ Volver ]"
                    custom_minimum_size = [12, 3]
                }

                Button "result_quit" {
                    text = "[ Salir ]"
                    custom_minimum_size = [10, 3]
                }
            }
        }
    }
}
