# Pantallas de los pasos 2 a 6 del wizard.
#
# Se injerta en "content/app_frame/shell/stage_slot" del shell. "steps" es el
# panel que entra y sale del escenario; adentro, step_a y step_b son las dos
# ranuras del pager que se cruzan cuando cambia el paso.

format = 1
name = "BooteableSteps"
theme = "booteable.gtheme"

Control "steps" {
    anchors = "full_rect"
    clip_children = true

    PanelContainer "step_a" {
        visible = false
        anchors = "full_rect"
        style = "step_panel"
        clip_children = true

        VBox "step_a_layout" {
            anchors = "full_rect"
            separation = 0

            Label "step_a_kicker" {
                text = "PASO 2 DE 6"
                custom_minimum_size = [0, 1]
                anchor_right = 1.0
                grow_x = "both"
                clip_children = true
                text_color = "BRIGHT_CYAN"
            }

            Label "step_a_title" {
                text = "Particionar"
                custom_minimum_size = [0, 1]
                anchor_right = 1.0
                grow_x = "both"
                clip_children = true
                text_color = "BRIGHT_WHITE"
            }

            Label "step_a_phase" {
                text = ""
                custom_minimum_size = [0, 2]
                anchor_right = 1.0
                grow_x = "both"
                clip_children = true
                text_color = "BRIGHT_YELLOW"
            }

            Label "step_a_description" {
                text = ""
                custom_minimum_size = [0, 3]
                anchor_right = 1.0
                grow_x = "both"
                clip_children = true
                text_color = "BRIGHT_WHITE"
            }

            HBox "step_a_status_row" {
                custom_minimum_size = [0, 1]
                anchor_right = 1.0
                grow_x = "both"
                separation = 1

                Spinner "step_a_spinner" {
                    custom_minimum_size = [1, 1]
                    interval = 0.12
                }

                Label "step_a_status" {
                    text = "Esperando..."
                    custom_minimum_size = [0, 1]
                    anchor_right = 1.0
                    grow_x = "both"
                    clip_children = true
                    text_color = "BRIGHT_WHITE"
                }
            }

            ProgressBar "step_a_bar" {
                custom_minimum_size = [0, 3]
                anchor_right = 1.0
                grow_x = "both"
                show_percentage = true
            }

            Label "step_a_dots" {
                text = ""
                custom_minimum_size = [0, 1]
                anchor_right = 1.0
                grow_x = "both"
                clip_children = true
                text_color = "BRIGHT_BLACK"
            }

            Label "step_a_log" {
                anchors = "full_rect"
                text = ""
                custom_minimum_size = [0, 3]
                clip_children = true
                text_color = "BRIGHT_BLACK"
            }

            HBox "step_a_buttons" {
                custom_minimum_size = [0, 3]
                separation = 2

                Button "step_a_cancel" {
                    text = "[ Esc · Cancelar ]"
                    custom_minimum_size = [20, 3]
                    style.normal = "button.warning.normal"
                    style.hover = "button.warning.hover"
                    style.pressed = "button.warning.pressed"
                    style.disabled = "button.warning.disabled"
                }
            }
        }
    }

    PanelContainer "step_b" {
        visible = false
        anchors = "full_rect"
        style = "step_panel"
        clip_children = true

        VBox "step_b_layout" {
            anchors = "full_rect"
            separation = 0

            Label "step_b_kicker" {
                text = "PASO 2 DE 6"
                custom_minimum_size = [0, 1]
                anchor_right = 1.0
                grow_x = "both"
                clip_children = true
                text_color = "BRIGHT_CYAN"
            }

            Label "step_b_title" {
                text = "Particionar"
                custom_minimum_size = [0, 1]
                anchor_right = 1.0
                grow_x = "both"
                clip_children = true
                text_color = "BRIGHT_WHITE"
            }

            Label "step_b_phase" {
                text = ""
                custom_minimum_size = [0, 2]
                anchor_right = 1.0
                grow_x = "both"
                clip_children = true
                text_color = "BRIGHT_YELLOW"
            }

            Label "step_b_description" {
                text = ""
                custom_minimum_size = [0, 3]
                anchor_right = 1.0
                grow_x = "both"
                clip_children = true
                text_color = "BRIGHT_WHITE"
            }

            HBox "step_b_status_row" {
                custom_minimum_size = [0, 1]
                anchor_right = 1.0
                grow_x = "both"
                separation = 1

                Spinner "step_b_spinner" {
                    custom_minimum_size = [1, 1]
                    interval = 0.12
                }

                Label "step_b_status" {
                    text = "Esperando..."
                    custom_minimum_size = [0, 1]
                    anchor_right = 1.0
                    grow_x = "both"
                    clip_children = true
                    text_color = "BRIGHT_WHITE"
                }
            }

            ProgressBar "step_b_bar" {
                custom_minimum_size = [0, 3]
                anchor_right = 1.0
                grow_x = "both"
                show_percentage = true
            }

            Label "step_b_dots" {
                text = ""
                custom_minimum_size = [0, 1]
                anchor_right = 1.0
                grow_x = "both"
                clip_children = true
                text_color = "BRIGHT_BLACK"
            }

            Label "step_b_log" {
                anchors = "full_rect"
                text = ""
                custom_minimum_size = [0, 3]
                clip_children = true
                text_color = "BRIGHT_BLACK"
            }

            HBox "step_b_buttons" {
                custom_minimum_size = [0, 3]
                separation = 2

                Button "step_b_cancel" {
                    text = "[ Esc · Cancelar ]"
                    custom_minimum_size = [20, 3]
                    style.normal = "button.warning.normal"
                    style.hover = "button.warning.hover"
                    style.pressed = "button.warning.pressed"
                    style.disabled = "button.warning.disabled"
                }
            }
        }
    }
}
